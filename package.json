{
  "name": "birthdaybot",
  "version": "1.2.0",
  "private": true,
  "description": "BirthdayBot for Discord",
  "keywords": [
    "birthday",
    "bot",
    "discord"
  ],
  "homepage": "https://github.com/chump29/birthdaybot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/birthdaybot.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "type": "module",
  "scripts": {
    "deps": "bunx --bun depcheck --ignores=\"@postfmly/config,@types/*,bun:*,lcov-total\"",
    "dev": "bun run --bun --watch index.ts",
    "env": "bun run --bun utils/env.ts",
    "env:test": "NODE_ENV=test bun run env",
    "preinstall": "bunx --bun only-allow bun",
    "lint": "bun run lint:spell && bun run lint:biome && bun run lint:ts",
    "lint:biome": "bun run --bun biome check --write --verbose --reporter=default --reporter=github --error-on-warnings",
    "lint:biome:ci": "bun run --bun biome ci --verbose --reporter=default --reporter=github --error-on-warnings",
    "lint:ci": "bun run lint:biome:ci && bun run lint:ts",
    "lint:spell": "bun run --bun cspell --dot --verbose .",
    "lint:ts": "bun check",
    "prepare": "bun run --bun .husky/prepare.min.mjs",
    "prod": "bun run --bun index.ts",
    "scan": "bun run scan:audit && bun run scan:cve && bun run scan:dupe",
    "scan:audit": "bun audit --production",
    "scan:cve": "bun run --bun cve-lite --check-maintenance --prod-only --only-used",
    "scan:dupe": "bun dedupe --check",
    "sql": "drizzle-kit generate",
    "test": "bun test --isolate --dots --preload ./tests/setup.ts --bail --check",
    "test:coverage": "bun test --isolate --dots --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --preload ./tests/setup.ts --bail --check",
    "test:coverage:full": "TEST_FULL=true bun test --isolate --coverage-dir ./tests/coverage --coverage-reporter=text --coverage-reporter=lcov --preload ./tests/setup.ts --bail --check",
    "test:full": "TEST_FULL=true bun test --isolate --preload ./tests/setup.ts --bail --check",
    "updates": "bunx --bun npm-check-updates --dep prod,dev --cooldown 0 --install never --packageManager bun --peer"
  },
  "lint-staged": {
    "*": "bun run --bun cspell --dot --no-must-find-files",
    "*.{json,md,ts,yaml}": "bun run --bun biome ci --no-errors-on-unmatched --error-on-warnings"
  },
  "dependencies": {
    "@postfmly/checkrate": "^2.0.13",
    "@postfmly/logger": "^1.2.6",
    "@postfmly/logoserver": "^1.4.0",
    "dayjs": "^1.11.23",
    "discord.js": "^14.28.0",
    "drizzle-orm": "1.0.0-rc.5",
    "envalid": "^9.0.0",
    "magic-regexp": "^0.11.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@postfmly/config": "^1.6.18",
    "@postfmly/types": "^1.0.12",
    "cve-lite-cli": "^1.40.0",
    "drizzle-kit": "1.0.0-rc.5",
    "expect-type": "^1.4.0",
    "husky": "^9.1.7",
    "lcov-total": "^2.1.1",
    "lint-staged": "^17.6.0",
    "ts-pattern": "^5.9.2"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "^1.4.4"
  },
  "engineStrict": true
}
